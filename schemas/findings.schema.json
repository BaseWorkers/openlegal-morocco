{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BaseWorkers/openlegal-morocco/schemas/findings/1.0.0",
  "title": "Open Legal Morocco Findings Export",
  "description": "Versioned, vendor-neutral technical findings and potential legal questions. A technical priority is not a legal-risk rating.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "repository", "verification_limitations", "findings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["tool", "version"],
      "properties": { "tool": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["revision"],
      "properties": { "revision": { "type": ["string", "null"], "description": "Commit/revision identifier when known; null otherwise." } }
    },
    "verification_limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "finding_type", "category", "priority", "priority_basis", "description", "legal_question", "evidence", "affected_resources", "legal_references", "suggested_controls", "review_status", "confidence", "schema_version"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "description": "Unique within one findings export; CLI and MCP semantic validation reject duplicate identifiers." },
        "finding_type": { "enum": ["technical_observation", "potential_legal_question"] },
        "category": { "type": "string", "minLength": 1 },
        "priority": {
          "enum": ["informational", "low", "medium", "high", "critical"],
          "description": "Technical remediation urgency only: informational records context without requiring remediation; low is non-urgent work suitable for a normal maintenance cycle; medium should be planned into a near-term remediation cycle; high warrants prompt remediation or mitigation; critical warrants urgent containment or remediation based on severe, well-supported technical impact. Consider observed impact, scope, exploitability, and evidence confidence. These labels do not assess legal risk, establish a legal duty, or indicate legal non-compliance."
        },
        "priority_basis": { "const": "technical_remediation", "description": "Required to make clear that priority is technical remediation sequencing and not legal-risk assessment." },
        "description": { "type": "string", "minLength": 1, "description": "Concise, sanitized statement. Do not include personal data, credentials, or confidential payloads." },
        "legal_question": { "type": ["string", "null"], "description": "Required as a non-empty string for potential_legal_question; null for technical_observation. An unresolved question, never a legal conclusion." },
        "evidence": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["summary", "source_reference", "verification_status"],
            "properties": {
              "summary": { "type": "string", "minLength": 1, "description": "Sanitized factual summary; no raw payload excerpts." },
              "source_reference": { "$ref": "#/$defs/sourceReference" },
              "verification_status": { "enum": ["unverified", "verified", "inaccessible", "not_applicable"] }
            }
          }
        },
        "affected_resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "legal_references": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["title", "uri", "pinpoint", "verification_status"],
            "properties": {
              "title": { "type": "string", "minLength": 1 }, "uri": { "type": ["string", "null"] },
              "pinpoint": { "type": ["string", "null"] },
              "verification_status": { "enum": ["unverified", "source_verified", "interpretation_reviewed", "conflicting", "inaccessible", "not_applicable"] }
            }
          }
        },
        "suggested_controls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["pii_detection", "data_minimization", "redaction", "tokenization", "encryption", "access_control", "audit_logging", "retention_management", "data_flow_mapping", "third_party_disclosure"] } },
        "review_status": {
          "type": "object", "additionalProperties": false, "required": ["verification", "human_review"],
          "properties": {
            "verification": { "enum": ["unverified", "partially_verified", "verified", "inaccessible"] },
            "human_review": { "enum": ["not_requested", "pending", "reviewed", "follow_up_required"] }
          }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Evidence confidence from 0 to 1, or null when not meaningfully measurable. Not legal certainty." },
        "schema_version": { "const": "1.0.0" }
      },
      "allOf": [
        { "if": { "properties": { "finding_type": { "const": "technical_observation" } }, "required": ["finding_type"] }, "then": { "properties": { "legal_question": { "type": "null" } } } },
        { "if": { "properties": { "finding_type": { "const": "potential_legal_question" } }, "required": ["finding_type"] }, "then": { "properties": { "legal_question": { "type": "string", "minLength": 1, "pattern": "\\\\S" } } } }
      ]
    },
    "sourceReference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path", "line_start", "line_end", "content_digest"],
      "properties": {
        "kind": { "enum": ["repository_file", "external_source", "tool_output", "other"] },
        "path": { "type": ["string", "null"], "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).*$", "description": "Repository-relative path using forward slashes only; absolute paths, backslashes, and parent-directory traversal are forbidden." }, "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "content_digest": { "type": ["string", "null"], "pattern": "^(sha256:)?[a-fA-F0-9]{64}$" }
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["type", "identifier"],
      "properties": { "type": { "enum": ["file", "service", "component", "repository"] }, "identifier": { "type": "string", "minLength": 1 } }
    }
  }
}
