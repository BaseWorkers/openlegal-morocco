{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-legal-morocco.example/schemas/clause-catalog.schema.json",
  "title": "Clause concept catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "composition_enabled", "clauses"],
  "properties": {
    "schema_version": { "const": 1 },
    "composition_enabled": { "const": false },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "group", "intent_question", "template_eligibility", "source_ids", "content_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "intent_question": { "type": "string", "minLength": 1 },
          "template_eligibility": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "content_status": { "enum": ["taxonomy-only", "draft", "researched", "reviewed"] }
        }
      }
    }
  }
}
