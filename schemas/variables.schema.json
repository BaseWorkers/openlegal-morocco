{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-legal-morocco.example/schemas/variables.schema.json",
  "title": "Template variable definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["variables"],
  "properties": {
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required", "description", "generator_input"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "number", "date", "boolean", "currency", "email", "address"] },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "generator_input": { "enum": ["factual", "approved_choice", "blocked"] },
          "maxLength": { "type": "integer", "minimum": 1 },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "enum": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
