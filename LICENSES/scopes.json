{
  "schema_version": 1,
  "status": "provisional",
  "notice": "This map records intended scope for original project-created material only. It is not a rights determination, contributor assignment, or legal review. Source-specific rights and notices take precedence.",
  "rules": [
    {
      "id": "original-content",
      "spdx": "CC0-1.0",
      "patterns": [
        "templates/**",
        "clauses/**",
        "research/**",
        "sources/**",
        "reviews/**"
      ],
      "exceptions": "Third-party text, source material, and individually authored reviewer submissions keep their own rights and notices."
    },
    {
      "id": "project-documentation",
      "spdx": "CC0-1.0",
      "patterns": [
        "README.md",
        "README.fr.md",
        "README.ar.md",
        "RELEASE_NOTES.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "REVIEWING.md",
        "DISCLAIMER.md",
        "GOVERNANCE.md",
        "SECURITY.md",
        "LICENSES/README.md",
        "LICENSES/scopes.json",
        ".github/ISSUE_TEMPLATE/**",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "skills/**",
        "docs/**"
      ],
      "exceptions": "Referenced third-party material is excluded."
    },
    {
      "id": "software-and-tooling",
      "spdx": "MIT",
      "patterns": [
        "scripts/**",
        "schemas/**",
        "tests/**",
        ".github/workflows/**",
        "package.json",
        ".gitignore",
        "mcp/**"
      ],
      "exceptions": "More specific path rules override this rule."
    },
    {
      "id": "synthetic-template-fixture",
      "spdx": "CC0-1.0",
      "patterns": [
        "tests/fixtures/template-package/**"
      ],
      "exceptions": "Synthetic test-only package declared CC0-1.0 by its fixture metadata; not a released legal template."
    },
    {
      "id": "upstream-license-texts",
      "spdx": null,
      "patterns": [
        "LICENSES/CC0-1.0.txt",
        "LICENSES/MIT.txt"
      ],
      "exceptions": "Keep upstream license text, copyright, and notices intact; do not apply the project license to these files."
    }
  ]
}
